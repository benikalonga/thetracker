PORT=4000
NODE_ENV=development
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:3306/thetracker"
# Comma-separated origins allowed to call the API from a browser.
CONSOLE_URL=http://localhost:3000
# Both must be 32+ characters and different: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Calendar days ("today", day plans, reports) are computed in this zone.
APP_TIMEZONE=UTC
# Used only by `npm run db:seed`.
SEED_PASSWORD=
